# Optional. Leave the key empty to create your account in the Portal setup page.
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_KEY=
# Optional. Comma-separated Clash YAML subscriptions used on first setup.
SUBSCR_URLS=
# Optional. Provide a new API key and recreate the container to rotate it.
CLASH_SECRET=
# Set 0.0.0.0 only when direct core API access is needed.
DASH_BIND_ADDRESS=127.0.0.1
